BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
VERIFICATION_GROUP_ID=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=eazychat

# Daily limits
DAILY_VIEW_LIMIT=15
DAILY_LIKE_LIMIT=10
DIRECT_MESSAGE_COST=2
CHAT_REQUEST_COST=2
LIKE_WITH_DIRECT_COST=2

# Bonuses
SIGNUP_BONUS=2
PROFILE_COMPLETE_BONUS=8
REFERRAL_BONUS=10
REFERRAL_PURCHASE_PERCENT=10

# Proxy (for filtered networks like Iran)
# Examples: http://127.0.0.1:10808 or socks5://127.0.0.1:10808
PROXY_URL=http://127.0.0.1:10808
